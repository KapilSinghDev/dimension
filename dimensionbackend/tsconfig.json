{
  "compilerOptions": {
    "lib": ["es2021","dom"],
    "target": "es2021",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./build",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "esModuleInterop":true,
    "strict": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}